{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "skipLibCheck": true, "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["apps/**/*.ts", "shared/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}

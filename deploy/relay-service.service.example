[Unit]
Description=Relay conversation service
After=network.target

[Service]
Type=simple
# Replace both absolute paths. Do not rely on an interactive shell's nvm setup.
WorkingDirectory=/ABSOLUTE/PATH/TO/Shared-agent-chat-app
ExecStart=/ABSOLUTE/PATH/TO/node apps/service/main.ts
Environment=HUB_BIND=127.0.0.1
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
